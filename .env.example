# Copy to `.env` for local development. Values here are PLACEHOLDERS —
# never commit a real `.env` (it is git-ignored). Production requires real
# secrets: the app refuses to start in production without them.

# Environment: development | test | production
NODE_ENV=development

# HTTP port (1-65535)
PORT=3000

# PostgreSQL connection string. REQUIRED in production.
# Local default is used when unset outside production.
DATABASE_URL=postgresql://phantom:phantom@localhost:5432/phantom_permission_dev

# HMAC pepper for API-key digests. REQUIRED in production, must not be a
# placeholder. Shown once at key issuance; never logged.
API_KEY_PEPPER=change-me-generate-a-long-random-string

# Comma-separated allowed origins for CORS. Empty = deny browser cross-origin.
CORS_ORIGINS=http://localhost:3000

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Max JSON body size (express-style, e.g. 1mb, 256kb)
REQUEST_BODY_LIMIT=1mb

# Rate limiting: max requests per window per client
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Metrics endpoint on/off: true | false
METRICS_ENABLED=true
